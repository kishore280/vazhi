FROM python:3.12-slim

WORKDIR /app

RUN pip install --no-cache-dir sqlalchemy[asyncio]==2.0.35 asyncpg==0.31.0 pydantic-settings==2.15.0

COPY package/vazhi/config.py package/vazhi/config.py
COPY package/vazhi/storage/postgres package/vazhi/storage/postgres
COPY package/vazhi/storage/__init__.py package/vazhi/storage/__init__.py
COPY package/vazhi/__init__.py package/vazhi/__init__.py
COPY migrate.py .

CMD ["python", "migrate.py"]
